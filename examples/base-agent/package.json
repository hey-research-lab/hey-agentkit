{
  "name": "hey-agentkit-base-agent-example",
  "version": "0.0.0",
  "private": true,
  "description": "An AgentKit agent on Base that checks a Robinhood Chain project with HEY Research Lab before it acts on the project's token.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@hey-research-lab/agentkit": "^0.2.0",
    "viem": "2.38.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@x402/svm": "2.28.0"
  },
  "pnpm": {
    "overrides": {
      "@x402/svm": "2.28.0"
    }
  }
}
