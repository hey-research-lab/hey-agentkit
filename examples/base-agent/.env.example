# Copy to .env and fill in what you use. Never commit .env.

# Optional: a HEY Research Lab API key (heyresearch.xyz/account). Every action works without one;
# a key lifts the anonymous rate limit and nothing else. Sent to heyresearch.xyz only.
HEY_API_KEY=

# Optional: a CDP server wallet for the agent on Base (portal.cdp.coinbase.com).
# Without all three, the example uses a throwaway in-memory Base account that holds nothing.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Optional: reuse an existing CDP wallet address instead of creating one.
CDP_WALLET_ADDRESS=

# Optional: the agent's network (default base-mainnet; base-sepolia for testing).
NETWORK_ID=base-mainnet
# Optional: your own Base RPC for the throwaway account (default: viem's public Base RPC).
BASE_RPC_URL=
